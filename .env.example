# 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local은 git에 올리지 않는다)
# 값이 비어 있으면 앱은 1단계 모드(브라우저에만 저장)로 동작한다.

# ── Supabase (대시보드 → Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=
# 브라우저에서 써도 되는 키 (실시간 동기화용). 예전 이름: anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버에서만 쓰는 키. 절대 NEXT_PUBLIC_ 을 붙이지 않는다. 예전 이름: service_role key
SUPABASE_SECRET_KEY=

# ── 2단계: 학습 기록을 서버에 저장할지 ──
NEXT_PUBLIC_REMOTE_SAVE=false

# ── 교사용 화면(/teacher) 비밀번호 ──
TEACHER_PIN=
